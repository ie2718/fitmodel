---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';

const logs = (await getCollection('changelog')).sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime(),
);
---

<Base
  title="更新日志 — FitModel"
  description="FitModel 的每次数据与内容变更记录：新证据采集、校验结果、排名变化。"
  image="/og/changelog.png"
>
  <header class="page-header">
    <h1>更新日志</h1>
    <p class="summary">每次数据采集、校验、排名变化都留痕在这里。</p>
  </header>

  {
    logs.map((log) => (
      <div class="log-item" id={log.id}>
        <p style="margin:0 0 4px">
          <span class="date">{log.data.date.toLocaleDateString('zh-CN')}</span>
          <strong>{log.data.title}</strong>
        </p>
        <ul class="plain">
          {log.data.entries.map((e) => (
            <li>{e}</li>
          ))}
        </ul>
      </div>
    ))
  }
</Base>
