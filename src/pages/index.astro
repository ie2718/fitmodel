---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import { CATEGORIES, siteUrl, absoluteUrl } from '../lib/meta';
import { getEngine } from '../lib/engine';
import { computePicks } from '../lib/picks';
import { CANONICAL_WEIGHTS, CANONICAL_WEIGHT_LINE } from '../lib/board';

const engine = await getEngine();
const scenarios = await getCollection('scenarios');
const models = await getCollection('models');
const products = await getCollection('products');
const evidence = await getCollection('evidence');

const overallTop = engine.rank(CANONICAL_WEIGHTS).slice(0, 5);
const fmtTop = (r: { fit: number | null; se: number }) =>
  `${r.fit?.toFixed(0) ?? '—'}`;

const picksOf = (e: (typeof scenarios)[number]) => {
  if (e.data.scoring_disabled) return null;
  const weights = Object.fromEntries((e.data.dimensions ?? []).map((x) => [x.id, x.weight]));
  return computePicks(engine, weights, models as never, products as never, e.data.category);
};

const catOrder = new Map(CATEGORIES.map((c, i) => [c.id, i]));
const sorted = [...scenarios].sort(
  (a, b) =>
    (catOrder.get(a.data.category) ?? 99) - (catOrder.get(b.data.category) ?? 99) ||
    a.data.title.localeCompare(b.data.title, 'zh-CN'),
);
const idxOf = new Map(sorted.map((s, i) => [s.id, i + 1]));

const groups = CATEGORIES.map((cat) => ({
  cat,
  items: sorted.filter((s) => s.data.category === cat.id),
})).filter((g) => g.items.length > 0);

const latestEvidence = evidence.reduce(
  (max, e) => (e.data.retrieved_at > max ? e.data.retrieved_at : max),
  evidence[0]?.data.retrieved_at ?? new Date(),
);
const shortTitle = (t: string) => t.split('：')[0];

const searchData = sorted.map((e) => ({
  t: e.data.title,
  s: e.data.summary,
  c: CATEGORIES.find((c) => c.id === e.data.category)?.label ?? '',
  u: siteUrl(`/scenarios/${e.id}/`),
}));

const site = Astro.site!;
const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    name: 'FitModel',
    alternateName: 'FitModel 选型指南',
    url: absoluteUrl('/', site),
    description: '按任务场景给出 AI 模型与产品推荐，结论由可溯源的公开数据计算生成。',
    inLanguage: 'zh-CN',
    potentialAction: {
      '@type': 'SearchAction',
      target: {
        '@type': 'EntryPoint',
        urlTemplate: absoluteUrl('/?q={search_term_string}', site),
      },
      'query-input': 'required name=search_term_string',
    },
    publisher: {
      '@type': 'Organization',
      name: 'FitModel',
      url: absoluteUrl('/', site),
      logo: { '@type': 'ImageObject', url: absoluteUrl('/favicon.svg', site) },
    },
  },
];
---

<Base
  title="FitModel — 该用什么 AI？证据驱动的选型指南"
  description="按任务查 AI 推荐：写作、编程、研究、办公、创意场景，免费够用 / 性价比 / 最强三档，结论全部由可溯源的公开数据计算生成，每周更新。"
  image="/og/index.png"
  schema={schema}
>
  <div class="home">
    <section class="hero">
      <h1>该用什么 AI？</h1>
      <p class="sub">按任务查推荐，全部由公开数据计算。</p>
      <p class="stamp mono">
        {evidence.length} 条公开证据 · 采集至 {latestEvidence.toLocaleDateString('zh-CN')} · 排名由算法生成
      </p>
      <div class="search-box">
        <input id="q" type="search" placeholder="写论文、做 PPT、写代码…" autocomplete="off" />
      </div>
      <div class="search-results" id="results" hidden></div>
    </section>

    <section class="top-strip">
      <h2 class="strip-label">
        <a href={siteUrl('/leaderboards/')}>综合能力榜 Top 5 →</a>
      </h2>
      <ol class="strip-list">
        {
          overallTop.map((r, i) => (
            <li>
              <span class="rk num">{i + 1}</span>
              <span class="v">{r.entity.variant}</span>
              <span class="num sc">{fmtTop(r)}</span>
            </li>
          ))
        }
      </ol>
      <p class="strip-note mono">
        0–100 指数 · 权重 {CANONICAL_WEIGHT_LINE} · 每分带 90% 误差界
      </p>
    </section>

    {
      groups.map(({ cat, items }) => (
        <section class="cat" id={`cat-${cat.id}`}>
          <header>
            <h2 class="cat-label">{cat.label}</h2>
            <span class="cat-desc">{cat.desc}</span>
          </header>
          <ul class="cards">
            {items.map((e) => {
              const picks = picksOf(e);
              const top = picks?.top ?? null;
              const value =
                picks?.valuePick && picks.valuePick.entity.key !== top?.entity.key
                  ? picks.valuePick
                  : null;
              const free = picks?.freePick ?? null;
              return (
                <li class={`card${picks === null ? ' wip' : ''}`}>
                  <span class="idx mono">{String(idxOf.get(e.id)).padStart(2, '0')}</span>
                  <h3>
                    <a href={siteUrl(`/scenarios/${e.id}/`)}>{shortTitle(e.data.title)}</a>
                  </h3>
                  {picks === null ? (
                    <p class="na">专项指标建库中，暂不评分——先看场景页建议。</p>
                  ) : (
                    <>
                      <p class="pick">
                        <span class="tier t-top">最强</span>
                        <span class="v">{top ? top.entity.variant : '—'}</span>
                        {top && <span class="num fit-tag">{fmtTop(top)}</span>}
                      </p>
                      <div class="alts">
                        <p>
                          <span class="tier">性价比</span>
                          <span class="v">{value ? value.entity.variant : '—'}</span>
                        </p>
                        <p>
                          <span class="tier t-free">免费</span>
                          <span class="v">{free ? free.product.name : '—'}</span>
                        </p>
                      </div>
                    </>
                  )}
                </li>
              );
            })}
          </ul>
        </section>
      ))
    }

    <section class="agent-cta">
      <p>
        <strong>AI Agent 接入</strong> —— 其他 Agent 与自动化工具可直接消费结构化推荐：{' '}
        <a href={siteUrl('/api/')}>JSON API 与 Skill 说明 →</a>
      </p>
    </section>

    <p class="note">
      「免费」= 有免费额度且国内可直接用的产品中最优；性价比与最强为同一模型时不重复列出。指标口径与算法见<a
        href={siteUrl('/methodology/')}>方法论</a>。
    </p>
  </div>

  <script type="application/json" id="search-data" set:html={JSON.stringify(searchData)} />
  <script>
    const data = JSON.parse(document.getElementById('search-data')?.textContent ?? '[]');
    const input = document.getElementById('q')!;
    const results = document.getElementById('results')!;

    function render(items: { t: string; s: string; c: string; u: string }[]) {
      results.innerHTML = '';
      for (const item of items) {
        const a = document.createElement('a');
        a.className = 'search-result';
        a.href = item.u;
        const t = document.createElement('div');
        t.className = 't';
        t.textContent = `${item.c} · ${item.t}`;
        const s = document.createElement('div');
        s.className = 's';
        s.textContent = item.s;
        a.append(t, s);
        results.append(a);
      }
      results.hidden = items.length === 0;
    }

    input.addEventListener('input', () => {
      const q = input.value.trim().toLowerCase();
      if (!q) {
        results.hidden = true;
        return;
      }
      render(
        data.filter((d: { t: string; s: string; c: string; u: string }) =>
          `${d.t} ${d.s} ${d.c}`.toLowerCase().includes(q),
        ).slice(0, 8),
      );
    });

    // 支持 ?q= 预填（配合 WebSite SearchAction，搜索结果页可直达）
    const initial = new URLSearchParams(location.search).get('q');
    if (initial) {
      input.value = initial;
      input.dispatchEvent(new Event('input'));
    }
  </script>
</Base>

<style>
  /* 「速查卡」：宋体提问 + 分类目录 + 卡片答案。颜色只给三个语义点：
     朱红=最强、绿=免费、墨=悬停；其余纸白细线。 */
  .home {
    --serif: 'Songti SC', 'STSong', 'Source Han Serif SC', 'Noto Serif SC', 'Noto Serif CJK SC',
      'SimSun', serif;
  }

  /* ---------- 首屏 ---------- */
  .hero {
    padding: 6px 0 24px;
    border-bottom: 3px double var(--ink);
  }
  .hero h1 {
    font-family: var(--serif);
    font-size: clamp(30px, 6.4vw, 44px);
    font-weight: 800;
    letter-spacing: 0.02em;
    line-height: 1.3;
    margin: 4px 0 8px;
  }
  .hero .sub {
    margin: 0 0 10px;
    color: var(--ink-2);
    font-size: 15px;
  }
  .stamp {
    font-size: 12px;
    color: var(--muted);
    margin: 0 0 18px;
  }
  .stamp::before {
    content: '';
    display: inline-block;
    width: 8px;
    height: 8px;
    background: var(--accent);
    margin-right: 8px;
    vertical-align: 0;
  }
  .hero .search-box input {
    border-radius: 0;
  }

  /* ---------- 分类目录 ---------- */
  .cat {
    margin-top: 34px;
  }
  .cat header {
    display: flex;
    align-items: baseline;
    gap: 10px;
    border-bottom: 1px solid var(--ink);
    padding-bottom: 6px;
    margin-bottom: 14px;
  }
  .cat-label {
    font-family: var(--serif);
    font-size: 18px;
    font-weight: 700;
    letter-spacing: 0.05em;
    margin: 0;
  }
  .cat-desc {
    font-size: 12.5px;
    color: var(--muted);
  }

  /* ---------- 卡片 ---------- */
  .cards {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 12px;
  }
  @media (max-width: 600px) {
    .cards {
      grid-template-columns: 1fr;
    }
  }

  .card {
    position: relative;
    border: 1px solid var(--hairline);
    padding: 14px 16px 12px;
    transition:
      border-color 0.16s ease,
      background-color 0.16s ease;
  }
  .card:hover {
    border-color: var(--ink);
    background: color-mix(in srgb, var(--accent) 3%, transparent);
  }
  .card.wip {
    border-style: dashed;
  }
  .card .idx {
    position: absolute;
    top: 14px;
    right: 14px;
    font-size: 11px;
    color: var(--muted);
  }
  .card h3 {
    margin: 0 2.6em 9px 0;
    font-size: 15.5px;
    line-height: 1.45;
    font-weight: 600;
  }
  .card h3 a {
    text-decoration: none;
  }
  .card h3 a:hover {
    color: var(--accent);
  }

  .tier {
    flex: none;
    width: 3.6em;
    font-size: 11.5px;
    letter-spacing: 0.1em;
    color: var(--muted);
  }
  .t-top {
    color: var(--accent);
    font-weight: 600;
  }
  .t-top::before {
    content: '';
    display: inline-block;
    width: 7px;
    height: 7px;
    background: var(--accent);
    margin-right: 6px;
    vertical-align: 0.5px;
  }
  .t-free::before {
    content: '';
    display: inline-block;
    width: 5px;
    height: 5px;
    background: var(--ok);
    margin: 0 8px 0 1px;
    vertical-align: 0.5px;
  }

  .pick {
    display: flex;
    align-items: baseline;
    margin: 0;
  }
  .pick .v {
    font-size: 18px;
    font-weight: 700;
    line-height: 1.4;
    overflow-wrap: anywhere;
  }

  .alts {
    margin-top: 10px;
    padding-top: 9px;
    border-top: 1px solid var(--hairline);
  }
  .alts p {
    display: flex;
    align-items: baseline;
    margin: 0 0 5px;
  }
  .alts p:last-child {
    margin-bottom: 0;
  }
  .alts .v {
    font-size: 13.5px;
    font-weight: 500;
    color: var(--ink-2);
    overflow-wrap: anywhere;
  }

  .na {
    margin: 2px 0 8px;
    font-size: 13px;
    color: var(--muted);
  }

  /* ---------- 综合能力榜速览条 ---------- */
  .top-strip {
    margin-top: 26px;
    border: 1px solid var(--hairline);
    padding: 14px 16px 12px;
  }
  .strip-label {
    margin: 0 0 10px;
    font-size: 13px;
    font-weight: 600;
    letter-spacing: 0.04em;
  }
  .strip-label a {
    text-decoration: none;
  }
  .strip-label a:hover {
    color: var(--accent);
  }
  .strip-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    gap: 10px;
  }
  @media (max-width: 720px) {
    .strip-list {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  .strip-list li {
    display: flex;
    align-items: baseline;
    gap: 7px;
    min-width: 0;
  }
  .strip-list .rk {
    font-size: 12px;
    color: var(--accent);
    font-weight: 600;
  }
  .strip-list .v {
    font-size: 13px;
    font-weight: 500;
    line-height: 1.35;
    overflow-wrap: anywhere;
    min-width: 0;
  }
  .strip-list .sc {
    margin-left: auto;
    font-size: 13px;
    font-weight: 600;
  }
  .strip-note {
    margin: 10px 0 0;
    font-size: 11.5px;
    color: var(--muted);
    overflow-wrap: anywhere;
  }

  .fit-tag {
    margin-left: auto;
    font-size: 12.5px;
    color: var(--muted);
  }

  /* ---------- Agent 接入横幅 ---------- */
  .agent-cta {
    margin-top: 36px;
    padding: 12px 16px;
    border-left: 3px solid var(--ink);
    font-size: 14px;
    color: var(--ink-2);
  }
  .agent-cta p {
    margin: 0;
  }
</style>
