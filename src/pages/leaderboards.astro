  }
  .tabs::-webkit-scrollbar {
    display: none;
  }
  .tabs button {
    appearance: none;
    background: none;
    border: none;
    border-bottom: 2px solid transparent;
    margin-bottom: -2px;
    padding: 9px 14px 7px;
    font: inherit;
    font-size: 14px;
    color: var(--muted);
    cursor: pointer;
    white-space: nowrap;
  }
  .tabs button:hover {
    color: var(--accent);
  }
  .tabs button.on {
    color: var(--ink);
    font-weight: 600;
    border-bottom-color: var(--accent);
  }
  .panel {
    padding-top: 4px;
  }
  .panel .section-title {
    margin-top: 26px;
  }
</style>
