---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import { siteUrl, absoluteUrl, isoDate } from '../lib/meta';
import { buildHarnessData } from '../lib/api';
import { getEngine } from '../lib/engine';
import { confidenceLabel, ci90 } from '../lib/scoring';
import {
  CANONICAL_WEIGHTS,
  CANONICAL_WEIGHT_LINE,
  BOARD_DIMS,
  DIM_LABEL,
  DIM_DESC,
  ciOverlaps,
  fmtScore,
} from '../lib/board';

const engine = await getEngine();
const harness = await buildHarnessData();
const metrics = await getCollection('metrics');
const models = await getCollection('models');
const evidence = await getCollection('evidence');
const modelById = new Map(models.map((m) => [m.id, m.data]));
const metricMeta = new Map(metrics.map((m) => [m.data.id, m.data]));

/** 综合能力指数：权重公示（改动需在 changelog 留痕），CI 重叠视为并列。
 *  仅价格证据、无任何能力数据的变体不入榜（先验分无信息量），单列说明。 */
const overall = engine.rank(CANONICAL_WEIGHTS);
const rankedKeys = new Set(overall.map((r) => r.entity.key));
const unrankedCount = [...engine.entities.values()].filter((e) => !rankedKeys.has(e.key)).length;

/** 维度榜：直接取引擎按维度聚合的百分位分 */
const dimBoard = (dim: string) =>
  [...engine.entities.values()]
    .filter((e) => e.dimScores[dim])
    .map((e) => ({ entity: e, ...e.dimScores[dim]! }))
    .sort((a, b) => b.score - a.score);

const dimBoards = BOARD_DIMS.map((dim) => ({ dim, rows: dimBoard(dim) }));
const agentRows = dimBoard('agent');

const priceStr = (r: (typeof overall)[number]) => {
  const pin = r.entity.facts['price_input_usd_m'];
  const pout = r.entity.facts['price_output_usd_m'];
  return pin && pout && !pin.stale && !pout.stale ? `$${pin.value}/$${pout.value}` : '—';
};

const fmt = (x: number) => x.toFixed(1).replace(/\.0$/, '');

/** 维度面板数据（渲染顺序即 tab 顺序；mirrors 单独渲染） */
const dimPanels = [
  ...dimBoards,
  { dim: 'agent', rows: agentRows },
] as const;

// ---- 原始来源数据镜像（「来源镜像」tab，供回查） ----
const BOARDS = [
  { metric: 'arena_elo_overall', title: 'Arena 总榜 Elo', desc: '真人盲测投票产生的 Elo，反映综合人类偏好。' },
  { metric: 'arena_rank_coding', title: 'Arena 编码榜', desc: '编码类目盲测排名，名次越小越强。' },
  { metric: 'arena_rank_writing', title: 'Arena 创意写作榜', desc: '创意写作类目盲测排名，名次越小越强。' },
  { metric: 'arena_agent_improvement', title: 'Arena Agent 榜（净改进率）', desc: 'agentic 任务的净改进率。' },
  { metric: 'swe_verified', title: 'SWE-bench Verified（bash-only）', desc: '真实 GitHub issue 的自动解决率；官方 mini-SWE-agent 统一环境口径。来源站最新一轮官方运行为 2026-02。' },
] as const;

const mirrors = BOARDS.map((b) => {
  const def = metricMeta.get(b.metric);
  const latest = new Map<string, (typeof evidence)[number]['data'] & { id: string }>();
  for (const e of evidence.filter((x) => x.data.metric === b.metric)) {
    const key = `${e.data.subject}::${e.data.variant}`;
    const prev = latest.get(key);
    if (!prev || e.data.retrieved_at > prev.retrieved_at) {
      latest.set(key, { ...e.data, id: e.id });
    }
  }
  const rows = [...latest.values()].sort((a, b2) =>
    def?.direction === 'lower' ? a.value - b2.value : b2.value - a.value,
  );
  return { ...b, def, rows };
});

const daysSince = (d: Date) => Math.floor((Date.now() - d.getTime()) / 86_400_000);
const fmtValue = (v: number, unit: string) =>
  unit === 'rank' ? `第 ${v} 名` : unit === 'percent' ? `${v}%` : String(v);

/** 真实用量榜（OpenRouter 周用量）：采用 ≠ 质量，仅展示，不进能力分 */
const usageMetric = 'openrouter_tokens_weekly';
const usageLatest = new Map<string, (typeof evidence)[number]['data'] & { id: string }>();
for (const e of evidence.filter((x) => x.data.metric === usageMetric)) {
  const key = `${e.data.subject}::${e.data.variant}`;
  const prev = usageLatest.get(key);
  if (!prev || e.data.retrieved_at > prev.retrieved_at) {
    usageLatest.set(key, { ...e.data, id: e.id });
  }
}
const usageRows = [...usageLatest.values()].sort((a, b) => b.value - a.value);

/** AA 智能指数榜（外部独立基准）：通用维度入分且指标权重 2×（2026-09-08 人工确认），
 *  与其他外部榜单一样保留原始值镜像，供逐条回查来源 */
const aaMetric = 'aa_intelligence_index';
const aaLatest = new Map<string, (typeof evidence)[number]['data'] & { id: string }>();
for (const e of evidence.filter((x) => x.data.metric === aaMetric)) {
  const key = `${e.data.subject}::${e.data.variant}`;
  const prev = aaLatest.get(key);
  if (!prev || e.data.retrieved_at > prev.retrieved_at) {
    aaLatest.set(key, { ...e.data, id: e.id });
  }
}
const aaRows = [...aaLatest.values()].sort((a, b) => b.value - a.value);

/** 社区口碑净信号（用户真实反馈的结构化转译）：rubric 见方法论「社区口碑」节 */
const csMetric = 'community_signal';
const csLatest = new Map<string, (typeof evidence)[number]['data'] & { id: string }>();
for (const e of evidence.filter((x) => x.data.metric === csMetric)) {
  const key = `${e.data.subject}::${e.data.variant}`;
  const prev = csLatest.get(key);
  if (!prev || e.data.retrieved_at > prev.retrieved_at) {
    csLatest.set(key, { ...e.data, id: e.id });
  }
}
const csRows = [...csLatest.values()].sort((a, b) => b.value - a.value);

const site = Astro.site!;
const dataAsOf = evidence.reduce(
  (max, e) => (e.data.retrieved_at > max ? e.data.retrieved_at : max),
  evidence[0]?.data.retrieved_at ?? new Date(),
);
const boardMetrics = [...metrics.filter((m) => BOARDS.some((b) => b.metric === m.data.id))];
const citations = [...new Set(evidence.map((e) => e.data.source_url))];
const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'Dataset',
    name: 'FitModel · 模型能力指数与公开评测镜像',
    description: `综合能力指数由多来源公开证据（权重：${CANONICAL_WEIGHT_LINE}）经归一化加权计算，每个分数带 90% 误差界；另含 AA 智能指数、Arena 人类偏好榜与 SWE-bench Verified 的原始镜像，每条可回查来源。`,
    url: absoluteUrl('/leaderboards/', site),
    inLanguage: 'zh-CN',
    isAccessibleForFree: true,
    keywords: ['LLM 排行榜', 'Arena', 'Elo', 'SWE-bench', 'AA 智能指数', 'Artificial Analysis', '模型能力指数', 'AI 选型'],
    license: 'https://creativecommons.org/licenses/by/4.0/',
    creator: { '@type': 'Organization', name: 'FitModel', url: absoluteUrl('/', site) },
    variableMeasured: boardMetrics.map((m) => m.data.label),
    citation: citations,
    dateModified: isoDate(dataAsOf),
  },
];
---

<Base
  title="模型榜单 — 综合能力指数与场景分 | FitModel"
  description="可信的 AI 模型榜单：综合能力指数由多来源公开证据加权计算，每个分数带 90% 误差界，区间重叠视为并列；分维度榜单 tab 切换，另附 Arena / SWE-bench 原始数据镜像。"
  image="/og/leaderboards.png"
  schema={schema}
>
  <header class="page-header">
    <h1>榜单</h1>
    <p class="summary">
      综合能力指数由公开证据计算：每条证据先在各自指标内归一化（名次 → Beta 后验百分位，Elo/百分比/价格 → z-score），再按可靠度（来源层级 × 时效 × 一致性）加权聚合成维度分，最后按公示权重合成。每个分数都带 <strong>90% 误差界</strong>——分数接近且区间重叠的模型视为并列（<span class="mono">≈</span>），我们不假装能分出高下。
    </p>
    <div class="meta-row">
      <span>数据截至 {isoDate(dataAsOf)}</span>
      <span>综合权重：{CANONICAL_WEIGHT_LINE}</span>
      <span><a href={siteUrl('/methodology/')}>口径与算法 →</a></span>
    </div>
  </header>

  <div class="tabs" role="tablist" aria-label="榜单切换">
    <button id="tab-overall" data-tab="overall" class="on" role="tab" aria-selected="true" aria-controls="panel-overall">综合</button>
    {BOARD_DIMS.map((dim) => (
      <button id={`tab-${dim}`} data-tab={dim} role="tab" aria-selected="false" aria-controls={`panel-${dim}`}>
        {DIM_LABEL[dim]}
      </button>
    ))}
    <button id="tab-agent" data-tab="agent" role="tab" aria-selected="false" aria-controls="panel-agent">Agent</button>
    <button id="tab-aa" data-tab="aa" role="tab" aria-selected="false" aria-controls="panel-aa">AA 智能指数</button>
    <button id="tab-cs" data-tab="cs" role="tab" aria-selected="false" aria-controls="panel-cs">用户口碑</button>
    <button id="tab-harness" data-tab="harness" role="tab" aria-selected="false" aria-controls="panel-harness">Harness</button>
    <button id="tab-usage" data-tab="usage" role="tab" aria-selected="false" aria-controls="panel-usage">真实用量</button>
    <button id="tab-mirrors" data-tab="mirrors" role="tab" aria-selected="false" aria-controls="panel-mirrors">来源镜像</button>
  </div>

  <section class="panel" id="panel-overall" role="tabpanel" aria-labelledby="tab-overall">
    <h2 class="section-title">综合能力指数</h2>
    <div class="table-wrap">
      <table>
        <thead>
          <tr>
            <th>#</th>
            <th>模型</th>
            <th>指数（90% 区间）</th>
            <th>置信度</th>
            <th>API 价格（入/出, $/M）</th>
            <th>性价比</th>
          </tr>
        </thead>
        <tbody>
          {
            overall.map((r, i) => {
              const prev = i > 0 ? overall[i - 1] : null;
              const tied = prev ? ciOverlaps(r.ci, prev.ci) : false;
              const cl = confidenceLabel(r.confidence);
              return (
                <tr>
                  <td class="num">
                    {i + 1}
                    {tied && <span class="tie">≈</span>}
                  </td>
                  <td>
                    {r.entity.variant}
                    <div class="sub">{modelById.get(r.entity.subject)?.name ?? r.entity.subject}</div>
                  </td>
                  <td class="num scorecell">
                    <strong>{fmtScore(r.fit ?? 0, r.se)}</strong>
                    <div class="scorebar" style={`--fit:${r.fit};--lo:${r.ci[0]};--hi:${r.ci[1]}`}>
                      <span class="fill" />
                      <span class="ci" />
                    </div>
                    <div class="sub">
                      {fmt(r.ci[0])}–{fmt(r.ci[1])}
                    </div>
                  </td>
                  <td>
                    <span class={`badge ${cl.cls}`}>{cl.label}</span>
                  </td>
                  <td class="num">{priceStr(r)}</td>
                  <td class="num">{r.value === null ? '—' : fmt(r.value)}</td>
                </tr>
              );
            })
          }
        </tbody>
      </table>
    </div>
    <p class="note">
      性价比 = 指数 ×（价格中位数 ÷ 自身混合价），上限 2×；「—」表示价格证据缺失。置信度综合证据覆盖、来源层级、样本量与一致性。
      {unrankedCount > 0 && `另有 ${unrankedCount} 个变体仅有价格证据、暂无能力数据，未列入排名（采证后自动加入）。`}
      新发布模型经 AA 智能指数先行入榜（当前如 GPT-6 Astra，低置信度），arena 收录后证据与置信度自动增强。
    </p>
  </section>

  {
    dimPanels.map(({ dim, rows }) => (
      <section class="panel" id={`panel-${dim}`} role="tabpanel" aria-labelledby={`tab-${dim}`} hidden>
        <h2 class="section-title">{DIM_LABEL[dim]}分榜</h2>
        <p class="note" style="margin:0 0 10px">
          {DIM_DESC[dim]}
        </p>
        {rows.length === 0 ? (
          <div class="callout">
            证据缺口：该维度尚无任何入分证据（<code class="num">{dim}</code> 指标建库中）。缺口不补零、不影响其他维度，只降低相关场景的覆盖率与置信度。
          </div>
        ) : (
          <div class="table-wrap">
            <table>
              <thead>
                <tr>
                  <th>#</th>
                  <th>模型</th>
                  <th>维度分（90% 区间）</th>
                  <th>依据</th>
                </tr>
              </thead>
              <tbody>
                {rows.map((row, i) => {
                  const ci = ci90(row.score, row.se);
                  const tied = i > 0 && ciOverlaps(ci, ci90(rows[i - 1].score, rows[i - 1].se));
                  const facts = Object.values(row.entity.facts).filter(
                    (f) =>
                      !f.stale &&
                      !f.prior &&
                      metricMeta.get(f.metric)?.dimension === dim,
                  );
                  return (
                    <tr>
                      <td class="num">
                        {i + 1}
                        {tied && <span class="tie">≈</span>}
                      </td>
                      <td>
                        {row.entity.variant}
                        <div class="sub">
                          {modelById.get(row.entity.subject)?.name ?? row.entity.subject}
                        </div>
                      </td>
                      <td class="num scorecell">
                        <strong>{fmtScore(row.score, row.se)}</strong>
                        <div class="scorebar" style={`--fit:${row.score};--lo:${ci[0]};--hi:${ci[1]}`}>
                          <span class="fill" />
                          <span class="ci" />
                        </div>
                        <div class="sub">
                          {fmt(ci[0])}–{fmt(ci[1])}
                        </div>
                      </td>
                      <td class="dim">
                        {facts
                          .map(
                            (f) =>
                              `${metricMeta.get(f.metric)?.label ?? f.metric} ${f.value}${
                                metricMeta.get(f.metric)?.unit === 'rank' ? ' 名' : ''
                              }${f.outlier ? '（类目覆盖存疑）' : ''}`,
                          )
                          .join('；') || '—'}
                      </td>
                    </tr>
                  );
                })}
              </tbody>
            </table>
          </div>
        )}
      </section>
    ))
  }

  <section class="panel" id="panel-aa" role="tabpanel" aria-labelledby="tab-aa" hidden>
    <h2 class="section-title">AA 智能指数（Artificial Analysis）</h2>
    <p class="note" style="margin:0 0 10px">
      外部独立基准榜：Artificial Analysis 自研 10 项评测加权合成（含私有 held-out 防污染），当前口径 <strong>v4.3</strong>（2026-09-08 快照）。它与其他外部榜单的不同在于<strong>直接进入通用维度评分，且指标权重 2×</strong>（2026-09-08 经人工确认上调）：独立方法论的第三方测量与 arena 人类盲测互为制衡，并承担 arena 未收录新模型的先行入榜通道。自 2026-09-12 起它同时是<strong>现役前沿锚</strong>——有其他实测却未上榜的变体（被 AA 下架的旧代，如 GPT-5.6 先例）按「非现役」先验 30±24 收缩，纯名次维度随之减半，详见<a href={siteUrl('/methodology/')}>方法论第四步</a>。v4.2→v4.3 数值整体下移（版本间不可比），同变体旧值已由 latest 聚合自动替换；来源柱状榜为准确读数，备注标「散点图读数」的条目约有 ±1 误差。
    </p>
    <div class="table-wrap">
      <table>
        <thead>
          <tr>
            <th>#</th>
            <th>模型</th>
            <th>智能指数</th>
            <th>来源</th>
            <th>采集</th>
          </tr>
        </thead>
        <tbody>
          {
            aaRows.map((r, i) => (
              <tr>
                <td class="num">{i + 1}</td>
                <td>
                  {r.variant}
                  <div class="sub">{modelById.get(r.subject)?.name ?? r.subject}{r.notes && ` · ${r.notes}`}</div>
                </td>
                <td class="num"><strong>{r.value}</strong></td>
                <td>
                  <a href={r.source_url} target="_blank" rel="noopener">{r.source} ↗</a>
                </td>
                <td class="num dim">{r.retrieved_at.toLocaleDateString('zh-CN')}</td>
              </tr>
            ))
          }
        </tbody>
      </table>
    </div>
  </section>

  <section class="panel" id="panel-cs" role="tabpanel" aria-labelledby="tab-cs" hidden>
    <h2 class="section-title">用户口碑（社区净信号）</h2>
    <p class="note" style="margin:0 0 10px">
      用户真实反馈的结构化转译（2026-09-12 起接入通用维度评分，tier 3 · weight 1，约 6% 综合话语权）：<strong>净信号 = 正面讨论串数 − 负面讨论串数</strong>，只计针对模型能力与使用体验的具体可归因陈述，混合倾向串不计，定价等真实使用反馈计入而自托管硬件门槛不计，每模型 ≥2 个独立讨论串才入册；无讨论数据的变体不参与本信号（不罚分）。自选样偏差大——它存在的意义是捕捉<strong>仪器分数与真实体验的背离</strong>。逐条引用与原帖链接见下表，分类 rubric 完整公示于<a href={siteUrl('/methodology/')}>方法论</a>。
    </p>
    <div class="table-wrap">
      <table>
        <thead>
          <tr>
            <th>#</th>
            <th>模型</th>
            <th>净信号（正/负）</th>
            <th>代表反馈与计数依据</th>
            <th>来源</th>
          </tr>
        </thead>
        <tbody>
          {
            csRows.map((r, i) => (
              <tr>
                <td class="num">{i + 1}</td>
                <td>
                  {r.variant}
                  <div class="sub">{modelById.get(r.subject)?.name ?? r.subject}</div>
                </td>
                <td class="num">
                  <strong>{r.value > 0 ? `+${r.value}` : r.value}</strong>
                </td>
                <td class="dim">{r.notes}</td>
                <td>
                  <a href={r.source_url} target="_blank" rel="noopener">{r.source} ↗</a>
                  <div class="sub num">{r.retrieved_at.toLocaleDateString('zh-CN')}</div>
                </td>
              </tr>
            ))
          }
        </tbody>
      </table>
    </div>
  </section>

  <section class="panel" id="panel-harness" role="tabpanel" aria-labelledby="tab-harness" hidden>
    <h2 class="section-title">Harness 榜（SWE-bench Verified 公开提交）</h2>
    <p class="note" style="margin:0 0 10px">
      Agent Harness（编码工具 / 脚手架）在 SWE-bench Verified 上的公开最好成绩，每工具取最优运行。<strong>口径注意</strong>：与模型榜的 bash-only 隔离口径不同——本榜是「harness × 搭配模型」的组合成绩，横向比较含模型因素，搭配模型已逐行明示。
    </p>
    <div class="table-wrap">
      <table>
        <thead>
          <tr>
            <th>#</th>
            <th>Harness</th>
            <th>最优成绩（% Resolved）</th>
            <th>搭配模型</th>
            <th>运行日期</th>
          </tr>
        </thead>
        <tbody>
          {
            harness.ranked.map((h, i) => (
              <tr>
                <td class="num">{i + 1}</td>
                <td>{h.name}</td>
                <td class="num"><strong>{h.score.toFixed(2).replace(/\.?0+$/, '')}</strong></td>
                <td class="dim">{h.model}</td>
                <td class="num dim" style="white-space:nowrap">{h.run_date ?? '—'}</td>
              </tr>
            ))
          }
        </tbody>
      </table>
    </div>
    <h2 class="section-title">未公开提交的知名 Harness</h2>
    <p class="note" style="margin:0 0 10px">
      以下产品未在 SWE-bench 公开提交成绩——列示产品属性、不参与排名；其能力请结合背后模型（见模型库）判断。
    </p>
    <div class="table-wrap">
      <table>
        <thead>
          <tr>
            <th>产品</th>
            <th>定价</th>
            <th>免费额度</th>
            <th>国内可用</th>
          </tr>
        </thead>
        <tbody>
          {
            harness.unpublished.map((p) => (
              <tr>
                <td>
                  {p.url ? (
                    <a href={p.url} target="_blank" rel="noopener">{p.name} ↗</a>
                  ) : (
                    p.name
                  )}
                </td>
                <td>{p.pricing}</td>
                <td class="dim">{p.free_tier || '—'}</td>
                <td class="dim">{p.availability_cn === 'direct' ? '直连' : p.availability_cn === 'restricted' ? '受限' : '不可用'}</td>
              </tr>
            ))
          }
        </tbody>
      </table>
    </div>
  </section>

  <section class="panel" id="panel-usage" role="tabpanel" aria-labelledby="tab-usage" hidden>
    <h2 class="section-title">真实用量榜（OpenRouter 周用量）</h2>
    <p class="note" style="margin:0 0 10px">
      来源站官方声明：「衡量采用，而非质量」——用量反映市场选择（价格、生态、免费额度都在起作用），与能力分是两个正交信号，故仅展示、不进入任何能力评分。
    </p>
    {
      usageRows.length === 0 ? (
        <div class="callout">该维度暂无证据。</div>
      ) : (
        <div class="table-wrap">
          <table>
            <thead>
              <tr>
                <th>#</th>
                <th>模型</th>
                <th>周用量（T tokens）</th>
                <th>来源</th>
                <th>采集</th>
              </tr>
            </thead>
            <tbody>
              {usageRows.map((r, i) => (
                <tr>
                  <td class="num">{i + 1}</td>
                  <td>
                    {r.variant}
                    <div class="sub">{modelById.get(r.subject)?.name ?? r.subject}{r.notes && ` · ${r.notes}`}</div>
                  </td>
                  <td class="num"><strong>{r.value}</strong></td>
                  <td>
                    <a href={r.source_url} target="_blank" rel="noopener">{r.source} ↗</a>
                  </td>
                  <td class="num dim">{r.retrieved_at.toLocaleDateString('zh-CN')}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      )
    }
  </section>

  <section class="panel" id="panel-mirrors" role="tabpanel" aria-labelledby="tab-mirrors" hidden>
    <h2 class="section-title">原始来源数据镜像</h2>
    <p class="note" style="margin:0 0 6px">
      上游榜单的原始值，每条可回查来源。SWE-bench 口径与采集日期是两回事：备注中的「官方运行」为来源站运行日期，采集列为本站快照日期。
    </p>
    {
      mirrors.map((b) => (
        <div style="margin-top:22px">
          <h3>{b.title}</h3>
          <p class="note" style="margin:0 0 8px">{b.desc}</p>
          <div class="table-wrap">
            <table>
              <thead>
                <tr>
                  <th>#</th>
                  <th>模型</th>
                  <th>{b.def?.unit === 'rank' ? '名次' : '数值'}</th>
                  <th>来源</th>
                  <th>采集</th>
                </tr>
              </thead>
              <tbody>
                {b.rows.map((r, i) => {
                  const stale = b.def && daysSince(r.retrieved_at) > b.def.freshness_days;
                  return (
                    <tr>
                      <td class="num">{i + 1}</td>
                      <td>
                        {r.variant}
                        <div class="sub">{modelById.get(r.subject)?.name ?? r.subject}{r.notes && ` · ${r.notes}`}</div>
                      </td>
                      <td class="num">
                        {fmtValue(r.value, b.def?.unit ?? '')}
                        {stale && <span class="dim"> 已过期，仅展示</span>}
                      </td>
                      <td>
                        <a href={r.source_url} target="_blank" rel="noopener">
                          {r.source} ↗
                        </a>
                      </td>
                      <td class="num dim">{r.retrieved_at.toLocaleDateString('zh-CN')}</td>
                    </tr>
                  );
                })}
              </tbody>
            </table>
          </div>
        </div>
      ))
    }
  </section>

  <p class="note">
    榜单口径与入分规则见<a href={siteUrl('/methodology/')}>方法论</a>；机器可读版本：<a href={siteUrl('/api/v1/models.json')}>/api/v1/models.json</a>。
  </p>

  <script>
    const tabs = [...document.querySelectorAll<HTMLButtonElement>('.tabs button')];
    const panelOf = (id: string) => document.getElementById(`panel-${id}`);
    function show(id: string, push = true) {
      for (const b of tabs) {
        const on = b.dataset.tab === id;
        b.classList.toggle('on', on);
        b.setAttribute('aria-selected', String(on));
      }
      for (const b of tabs) {
        const p = panelOf(b.dataset.tab!);
        if (p) p.hidden = b.dataset.tab !== id;
      }
      if (push) history.replaceState(null, '', `#${id}`);
    }
    tabs.forEach((b) => b.addEventListener('click', () => show(b.dataset.tab!)));
    const initial = location.hash.slice(1);
    show(initial && panelOf(initial) ? initial : 'overall', false);
  </script>
</Base>

