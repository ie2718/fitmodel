---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { freshness, absoluteUrl, isoDate, siteUrl, CATEGORY_MAP } from '../../lib/meta';
import { confidenceLabel, ci90, type FitResult } from '../../lib/scoring';
import { getEngine } from '../../lib/engine';
import { computePicks } from '../../lib/picks';
import { DIM_LABEL, ciOverlaps } from '../../lib/board';

export async function getStaticPaths() {
  const items = await getCollection('scenarios');
  return items.map((entry) => ({ params: { id: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const d = entry.data;

const engine = await getEngine();
const metrics = await getCollection('metrics');
const metricMeta = new Map(metrics.map((m) => [m.data.id, m.data]));
const models = await getCollection('models');
const products = await getCollection('products');
const modelById = new Map(models.map((m) => [m.id, m.data]));

const fresh = freshness(d.last_verified);

const weights = Object.fromEntries((d.dimensions ?? []).map((x) => [x.id, x.weight]));
const picks = d.scoring_disabled
  ? null
  : computePicks(engine, weights, models as never, products as never, d.category);
const ranked: FitResult[] = picks?.ranked ?? [];
const top = picks?.top ?? null;
const valuePick = picks?.valuePick ?? null;
const freePick = picks?.freePick ?? null;

const productsFor = (subject: string) =>
  products.filter((p) => p.data.models_used.includes(subject));
const primaryProduct = (subject: string) =>
  productsFor(subject).find((p) => ['chat', 'coding'].includes(p.data.category)) ??
  productsFor(subject)[0];

function factLine(r: FitResult, n = 2): string {
  return Object.values(r.entity.facts)
    .filter((f) => !f.stale)
    .sort((a, b) => b.score - a.score)
    .slice(0, n)
    .map((f) => {
      const meta = metricMeta.get(f.metric);
      return `${meta?.label ?? f.metric} ${f.value}${meta?.unit === 'rank' ? ' 名' : ''}`;
    })
    .join('；');
}

const priceStr = (r: FitResult) => {
  const pin = r.entity.facts['price_input_usd_m'];
  const pout = r.entity.facts['price_output_usd_m'];
  return pin && pout ? `API $${pin.value}/$${pout.value} 每百万 tokens` : '';
};

const citationIds = new Set<string>();
for (const r of ranked.slice(0, 8)) {
  for (const f of Object.values(r.entity.facts)) citationIds.add(f.evidId);
}
const evidenceEntries = (await getCollection('evidence'))
  .filter((e) => citationIds.has(e.data.id))
  .sort((a, b) => a.data.id.localeCompare(b.data.id));

const dimShort: Record<string, string> = DIM_LABEL;
const fmtFit = (x: number | null | undefined) => (x == null ? '—' : x.toFixed(0));
/** 「89 ±6」形式：分数 + 90% 误差界半宽 */
const fmtFitCi = (r: FitResult) => `${fmtFit(r.fit)} ±${Math.max(1, Math.round(1.645 * r.se))}`;
const weightLine = d.dimensions
  .map((x) => `${dimShort[x.id] ?? x.id} ${Math.round(x.weight * 100)}%`)
  .join(' · ');

const site = Astro.site!;
const pageUrl = absoluteUrl(`/scenarios/${entry.id}/`, site);
const ogImage = `/og/scenarios/${entry.id}.png`;
const dataAsOf =
  evidenceEntries.reduce<Date | null>(
    (max, e) => (!max || e.data.retrieved_at > max ? e.data.retrieved_at : max),
    null,
  ) ?? d.last_verified;

const pageTitle = d.scoring_disabled
  ? `${d.title}怎么选？避坑与建议 | FitModel`
  : `${d.title}用什么 AI？证据驱动的模型推荐 | FitModel`;

const schema: Record<string, unknown>[] = [
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'FitModel', item: absoluteUrl('/', site) },
      {
        '@type': 'ListItem',
        position: 2,
        name: CATEGORY_MAP[d.category]?.label ?? d.category,
        item: absoluteUrl(`/#cat-${d.category}`, site),
      },
      { '@type': 'ListItem', position: 3, name: d.title, item: pageUrl },
    ],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'Article',
    headline: d.title,
    description: d.summary,
    inLanguage: 'zh-CN',
    url: pageUrl,
    mainEntityOfPage: pageUrl,
    image: absoluteUrl(ogImage, site),
    dateModified: isoDate(dataAsOf),
    author: { '@type': 'Organization', name: 'FitModel', url: absoluteUrl('/', site) },
    publisher: { '@type': 'Organization', name: 'FitModel' },
  },
];
if (ranked.length > 0) {
  schema.push({
    '@context': 'https://schema.org',
    '@type': 'ItemList',
    name: `${d.title} · 模型适配排名`,
    description: `按场景维度权重加权计算的模型适配分排名，数据截至 ${isoDate(dataAsOf)}。`,
    numberOfItems: ranked.length,
    itemListElement: ranked.slice(0, 10).map((r, i) => ({
      '@type': 'ListItem',
      position: i + 1,
      name: r.entity.variant,
    })),
  });
}
if (!d.scoring_disabled && top) {
  const faqs: Record<string, unknown>[] = [
    {
      '@type': 'Question',
      name: `${d.title}用什么 AI 模型最好？`,
      acceptedAnswer: {
        '@type': 'Answer',
        text: `截至 ${isoDate(dataAsOf)}，基于 ${evidenceEntries.length} 条可溯源的公开证据计算，综合适配最高的是 ${top.entity.variant}（适配 ${fmtFitCi(top)}，90% 误差界，置信度${confidenceLabel(top.confidence).label}）。依据与完整排名见本页。`,
      },
    },
  ];
  if (freePick) {
    faqs.push({
      '@type': 'Question',
      name: `${d.title}有没有免费的工具可用？`,
      acceptedAnswer: {
        '@type': 'Answer',
        text: `免费首选：${freePick.product.name}（${freePick.product.free_tier}），底座模型家族为 ${freePick.base_family}（免费档不承诺具体变体）。三档推荐规则见方法论页。`,
      },
    });
  }
  faqs.push({
    '@type': 'Question',
    name: '这些推荐是怎么算出来的？',
    acceptedAnswer: {
      '@type': 'Answer',
      text: '全部由公开数据（厂商官方定价页、arena.ai、SWE-bench 等）经统一算法加权计算生成，数据过期自动不入分，方法完全公示，无人为主观挑选。',
    },
  });
  schema.push({ '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: faqs });
}
---

<Base title={pageTitle} description={d.summary} type="article" image={ogImage} schema={schema}>
  <article>
    <header class="page-header">
      <h1>{d.title}</h1>
      <p class="summary">{d.summary}</p>
      <div class="meta-row">
        <span class={`badge ${fresh.cls}`}>{fresh.label}</span>
        {d.status === 'draft' && <span>草稿 · 权重待复审</span>}
        {weightLine && <span>权重：{weightLine}</span>}
      </div>
      {!d.scoring_disabled && top && (
        <p class="direct">
          截至 {isoDate(dataAsOf)}，基于 {evidenceEntries.length} 条公开证据，本场景综合适配最高的是
          {top.entity.variant}（适配 {fmtFitCi(top)}，置信度
          {confidenceLabel(top.confidence).label}；误差界重叠的后续名次视为并列）。
        </p>
      )}
    </header>

    {
      d.scoring_disabled ? (
        <>
          <div class="callout">
            <strong>本场景暂不评分。</strong>
            {d.scoring_note}
          </div>
          <section>
            <h2 class="section-title">避坑与建议</h2>
            <p class="note">以下为编辑经验，不参与排名。</p>
            {d.pitfalls.length > 0 && (
              <ul class="plain">
                {d.pitfalls.map((p) => (
                  <li>{p}</li>
                ))}
              </ul>
            )}
            <div class="prose">
              <Content />
            </div>
          </section>
        </>
      ) : (
        <>
          <section>
            <h2 class="section-title">推荐</h2>
            <dl class="answer">
              {top && (
                <div class="row">
                  <dt>最强</dt>
                  <dd>
                    {top.entity.variant}
                    <span class="dim">
                      适配 {fmtFitCi(top)} · 置信度{confidenceLabel(top.confidence).label}
                      {priceStr(top) && ` · ${priceStr(top)}`}
                    </span>
                  </dd>
                </div>
              )}
              {top && (
                <p class="why">
                  依据：{factLine(top)}。
                  {primaryProduct(top.entity.subject)?.data.name
                    ? ` 入口产品：${primaryProduct(top.entity.subject)!.data.name}。`
                    : ''}
                </p>
              )}
              {valuePick && valuePick.entity.key !== top?.entity.key && (
                <div class="row">
                  <dt>性价比</dt>
                  <dd>
                    {valuePick.entity.variant}
                    <span class="dim">
                      适配 {fmtFitCi(valuePick)}{priceStr(valuePick) && ` · ${priceStr(valuePick)}`}
                    </span>
                  </dd>
                </div>
              )}
              {freePick && (
                <div class="row">
                  <dt>免费</dt>
                  <dd>
                    {freePick.product.name}
                    <span class="dim">
                      底座 {freePick.base_family.replace(/\s*系列$/, '')}（不承诺具体变体） ·{' '}
                      {freePick.product.free_tier}
                    </span>
                  </dd>
                </div>
              )}
              {!top && <div class="callout">证据采集中：该场景暂无足够数据生成排名。</div>}
            </dl>
            {top && !freePick && (
              <p class="note">
                免费入口类工具（Cursor 等 Harness）不在此列——规划中的 Harness 榜单将单独收录与评测。
              </p>
            )}
          </section>

          {ranked.length > 0 && (
            <details class="fold" open>
              <summary>完整排名（{ranked.length} 个模型变体，误差界重叠视为并列 ≈）</summary>
              <div class="inner table-wrap">
                <table>
                  <thead>
                    <tr>
                      <th>#</th>
                      <th>模型</th>
                      <th>适配分（90% 区间）</th>
                      <th>置信度</th>
                      <th>API 价格（入/出, $/M）</th>
                    </tr>
                  </thead>
                  <tbody>
                    {ranked.map((r, i) => {
                      const pin = r.entity.facts['price_input_usd_m'];
                      const pout = r.entity.facts['price_output_usd_m'];
                      const cl = confidenceLabel(r.confidence);
                      const tied = i > 0 && ciOverlaps(r.ci, ranked[i - 1].ci);
                      return (
                        <tr>
                          <td class="num">
                            {i + 1}
                            {tied && <span class="tie">≈</span>}
                          </td>
                          <td>
                            {r.entity.variant}
                            <div class="sub">
                              {modelById.get(r.entity.subject)?.name ?? '厂商核实中'}
                            </div>
                          </td>
                          <td class="num scorecell">
                            <strong>{fmtFitCi(r)}</strong>
                            <div class="scorebar" style={`--fit:${r.fit};--lo:${r.ci[0]};--hi:${r.ci[1]}`}>
                              <span class="fill" />
                              <span class="ci" />
                            </div>
                          </td>
                          <td class="dim">{cl.label}</td>
                          <td class="num">{pin && pout ? `${pin.value} / ${pout.value}` : '—'}</td>
                        </tr>
                      );
                    })}
                  </tbody>
                </table>
              </div>
            </details>
          )}

          {ranked.length > 0 && (
            <p class="note">
              机器可读数据（含误差界与依据）：{' '}
              <a href={siteUrl(`/api/v1/scenarios/${entry.id}.json`)}>
                /api/v1/scenarios/{entry.id}.json
              </a>
            </p>
          )}

          <details class="fold">
            <summary>数据依据（{evidenceEntries.length} 条，可回查原文）</summary>
            <ul class="evidence-list">
              {evidenceEntries.map((e) => (
                <li>
                  <span>{metricMeta.get(e.data.metric)?.label ?? e.data.metric} <strong class="num">{e.data.value}</strong></span>
                  <a href={e.data.source_url} target="_blank" rel="noopener">{e.data.source} ↗</a>
                  <span class="mono">{e.data.retrieved_at.toLocaleDateString('zh-CN')}</span>
                  {e.data.notes && <span class="dim">※ {e.data.notes}</span>}
                </li>
              ))}
            </ul>
          </details>

          <section>
            <h2 class="section-title">避坑与建议</h2>
            <p class="note">以下为编辑经验，不参与排名。</p>
            {d.pitfalls.length > 0 && (
              <ul class="plain">
                {d.pitfalls.map((p) => (
                  <li>{p}</li>
                ))}
              </ul>
            )}
            <div class="prose">
              <Content />
            </div>
          </section>
        </>
      )
    }
  </article>
</Base>
